{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RecordEventLine",
  "description": "Record event line (schema_v 1 legacy or schema_v 2 bus envelope).\n\nTop-level `deny_unknown_fields` lives only on this struct so new v2 keys land in one place (`EventEnvelope` + `EventEnvelopeV2Optional`) without a schema_v 3.",
  "type": "object",
  "required": [
    "aggregate",
    "event_time",
    "id",
    "key",
    "payload",
    "record_time",
    "schema_v",
    "source",
    "v",
    "version"
  ],
  "properties": {
    "aggregate": {
      "type": "string"
    },
    "cause": {
      "anyOf": [
        {
          "$ref": "#/definitions/EventId"
        },
        {
          "type": "null"
        }
      ]
    },
    "clock": {
      "anyOf": [
        {
          "$ref": "#/definitions/ClockInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "depth": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint8",
      "minimum": 0.0
    },
    "event_time": {
      "type": "string"
    },
    "event_time_prec": {
      "anyOf": [
        {
          "$ref": "#/definitions/EventTimePrec"
        },
        {
          "type": "null"
        }
      ]
    },
    "hlc": {
      "anyOf": [
        {
          "$ref": "#/definitions/HlcWire"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "$ref": "#/definitions/EventId"
    },
    "key": {
      "type": "string"
    },
    "node": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "$ref": "#/definitions/RecordEventPayload"
    },
    "prev_hash": {
      "anyOf": [
        {
          "$ref": "#/definitions/Hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "record_time": {
      "type": "string"
    },
    "rule": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_v": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "seq": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "source": {
      "$ref": "#/definitions/Source"
    },
    "v": {
      "const": 1
    },
    "version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "writer": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "ClockInfo": {
      "description": "Wall-clock sync metadata on a v2 line. `src` is an open string (`chrony`, `sntp`, `peer:<alias>`, `none`, `roughtime`, …).",
      "type": "object",
      "required": [
        "age_s",
        "err_us",
        "off_us",
        "src"
      ],
      "properties": {
        "age_s": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "err_us": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "off_us": {
          "type": "integer",
          "format": "int64"
        },
        "src": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "EventId": {
      "type": "string"
    },
    "EventTimePrec": {
      "type": "string",
      "enum": [
        "us",
        "ms",
        "s",
        "min",
        "day",
        "unknown"
      ]
    },
    "Hash": {
      "type": "string"
    },
    "HlcWire": {
      "type": "object",
      "required": [
        "c",
        "l"
      ],
      "properties": {
        "c": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "l": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "RecordEventPayload": {
      "type": "object",
      "required": [
        "company",
        "host"
      ],
      "properties": {
        "company": {
          "type": "string"
        },
        "host": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Source": {
      "type": "string",
      "enum": [
        "owner",
        "collab-finder",
        "cos-copy",
        "gmail",
        "linear",
        "ats",
        "human",
        "document",
        "legacy-unknown"
      ]
    }
  }
}
