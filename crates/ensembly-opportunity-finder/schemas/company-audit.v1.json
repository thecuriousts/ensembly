{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditLine",
  "type": "object",
  "required": [
    "audited_at",
    "checks",
    "company",
    "domain",
    "v",
    "verdict"
  ],
  "properties": {
    "apply_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "audited_at": {
      "type": "string"
    },
    "audited_by": {
      "description": "Who recorded the audit. Absent when the field was omitted (a row written before it existed) or JSON null. Readers must not fill in a label. A new append still requires a non-blank value.",
      "type": [
        "string",
        "null"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Check"
      }
    },
    "company": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "reused_from": {
      "description": "Optional `audited_at` of the earlier audit whose result this row reuses.",
      "type": [
        "string",
        "null"
      ]
    },
    "v": {
      "const": 1
    },
    "verdict": {
      "$ref": "#/definitions/Verdict"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Check": {
      "type": "object",
      "required": [
        "id",
        "note",
        "result",
        "sources"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/CheckId"
        },
        "note": {
          "type": "string"
        },
        "result": {
          "$ref": "#/definitions/CheckResult"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "CheckId": {
      "type": "string",
      "enum": [
        "apply_domain",
        "domain_age",
        "funding_ownership",
        "headcount",
        "reviews_news",
        "duplicate_ghost",
        "payment_id_ask",
        "agency_repost"
      ]
    },
    "CheckResult": {
      "type": "string",
      "enum": [
        "pass",
        "flag",
        "block",
        "unknown"
      ]
    },
    "Verdict": {
      "type": "string",
      "enum": [
        "pass",
        "flag",
        "block"
      ]
    }
  }
}
