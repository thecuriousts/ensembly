{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LedgerRowLine",
  "type": "object",
  "required": [
    "company",
    "cv_version",
    "link",
    "role",
    "status",
    "v"
  ],
  "properties": {
    "apply_url": {
      "description": "Optional application-form URL (e.g. `…/application`); `link` stays the canonical posting.",
      "type": [
        "string",
        "null"
      ]
    },
    "company": {
      "type": "string"
    },
    "cv_version": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "status": {
      "$ref": "#/definitions/Status"
    },
    "submit_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "submit_time_unknown": {
      "description": "`true` when the application was sent but the time was never recorded (then `submit_time` is null). Absent otherwise; never `false`.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "v": {
      "const": 1
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Status": {
      "type": "string",
      "enum": [
        "prepared",
        "submitted",
        "interview",
        "rejected",
        "withdrawn",
        "silent-closed"
      ]
    }
  }
}
