#!/usr/bin/env python3
import argparse
import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)

from metrics import compute, default_window, parse_day
from render import render


def main(argv=None):
    since_default, until_default = default_window()
    parser = argparse.ArgumentParser(description="Scoreboard from public repository evidence")
    parser.add_argument("--since", default=since_default.isoformat(), help="UTC start date YYYY-MM-DD, inclusive")
    parser.add_argument("--until", default=until_default.isoformat(), help="UTC end date YYYY-MM-DD, inclusive")
    parser.add_argument("--output", "-o", help="Write markdown here instead of stdout")
    parser.add_argument("--fixture", help="Read snapshot JSON instead of calling gh")
    parser.add_argument("--owners", default="p10ns11y,thecuriousts")
    args = parser.parse_args(argv)
    since = parse_day(args.since)
    until = parse_day(args.until)
    if args.fixture:
        with open(args.fixture) as handle:
            snapshot = json.load(handle)
    else:
        from fetch import collect_snapshot
        owners = [part.strip() for part in args.owners.split(",") if part.strip()]
        snapshot = collect_snapshot(since, until, owners)
    text = render(compute(snapshot, since, until))
    if args.output:
        parent = os.path.dirname(os.path.abspath(args.output))
        if parent:
            os.makedirs(parent, exist_ok=True)
        with open(args.output, "w") as handle:
            handle.write(text)
    else:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
