#!/usr/bin/env python3
"""Verify every owner/repo@<40-hex> pin in .github/workflows exists on GitHub."""
from __future__ import annotations

import os
import re
import sys
import urllib.error
import urllib.request
from pathlib import Path

USE_RE = re.compile(
    r"^\s*-\s+uses:\s+([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)@([0-9a-f]{40})\b",
    re.MULTILINE,
)

API = "https://api.github.com"


def repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def collect_pins(workflows_dir: Path, root: Path) -> list[tuple[str, str, str, str]]:
    out: list[tuple[str, str, str, str]] = []
    for path in sorted(workflows_dir.glob("*.yml")):
        text = path.read_text(encoding="utf-8")
        for match in USE_RE.finditer(text):
            slug, sha = match.group(1), match.group(2)
            owner, repo = slug.split("/", 1)
            out.append((str(path.relative_to(root)), owner, repo, sha))
    return out


def commit_exists(token: str, owner: str, repo: str, sha: str) -> bool:
    url = f"{API}/repos/{owner}/{repo}/git/commits/{sha}"
    req = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "User-Agent": "ensembly-check-action-pins",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.status == 200
    except urllib.error.HTTPError as exc:
        if exc.code == 404:
            return False
        raise


def main() -> int:
    token = os.environ.get("GITHUB_TOKEN", "").strip()
    if not token:
        print("GITHUB_TOKEN required", file=sys.stderr)
        return 2
    root = repo_root()
    workflows = root / ".github" / "workflows"
    pins = collect_pins(workflows, root)
    if not pins:
        print("no action pins found", file=sys.stderr)
        return 2
    failed: list[str] = []
    cache: dict[tuple[str, str, str], bool] = {}
    for relpath, owner, repo, sha in pins:
        key = (owner, repo, sha)
        if key not in cache:
            try:
                cache[key] = commit_exists(token, owner, repo, sha)
            except urllib.error.URLError as exc:
                print(f"network error for {owner}/{repo}@{sha}: {exc}", file=sys.stderr)
                return 2
            except urllib.error.HTTPError as exc:
                print(f"API error for {owner}/{repo}@{sha}: {exc.code}", file=sys.stderr)
                return 2
        if not cache[key]:
            failed.append(f"{relpath}: {owner}/{repo}@{sha} (missing on GitHub)")
    if failed:
        for line in failed:
            print(line, file=sys.stderr)
        print(f"{len(failed)} invalid action pin(s)", file=sys.stderr)
        return 1
    print(f"ok: {len(pins)} pin(s) verified")
    return 0


if __name__ == "__main__":
    sys.exit(main())