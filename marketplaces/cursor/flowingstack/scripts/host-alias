#!/usr/bin/env python3
import argparse
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from rootpath import plugin_root, rel, walk

RULES = [
    ("home-path", r"/home/[a-z_][\w.-]*|/Users/[A-Za-z][\w.-]*"),
    ("cgnat-ip", r"\b100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.\d{1,3}\.\d{1,3}\b"),
]
MAGIC = (b"\x7fELF", b"\xfe\xed\xfa", b"\xce\xfa\xed\xfe", b"\xcf\xfa\xed\xfe", b"\xca\xfe\xba\xbe", b"MZ")


def deny_rules(path):
    if not path or not os.path.exists(path):
        return []
    return [("deny-list", r"(?i)\b" + re.escape(l.strip()) + r"\b") for l in open(path) if l.strip()]


def scan_text(name, text, rules):
    hits = []
    for n, line in enumerate(text.split("\n"), 1):
        for rule, pat in rules:
            if re.search(pat, line):
                hits.append(f"{name}:{n}: {rule}")
    return hits


def scan_file(root, r, rules):
    full = os.path.join(root, r)
    if os.path.islink(full):
        return [f"{r}: symlink"]
    data = open(full, "rb").read()
    if b"\0" in data or data.startswith(MAGIC):
        return [f"{r}: binary"]
    return scan_text(r, data.decode("utf-8", "replace"), rules)


def main():
    a = argparse.ArgumentParser(description="scan for home paths, CGNAT ips, and denied host names")
    a.add_argument("paths", nargs="*")
    a.add_argument("--root")
    a.add_argument("--all", action="store_true")
    a.add_argument("--deny", default=os.environ.get("FS_HOST_ALIAS_DENY"))
    a.add_argument("--stdin", action="store_true")
    o = a.parse_args()
    root = plugin_root(o.root)
    rules = RULES + deny_rules(o.deny)
    hits = []
    if o.stdin:
        hits += scan_text("stdin", sys.stdin.read(), rules)
    ignore = "privacy-ignore" if os.path.isfile(os.path.join(root, "privacy-ignore")) else "\0"
    files = list(walk(root, ignore)) if o.all else []
    for p in o.paths:
        full = rel(root, p)
        files += [os.path.relpath(os.path.join(full, q), root) for q in walk(full, "\0")] if os.path.isdir(full) else [p]
    for r in files:
        hits += scan_file(root, r, rules)
    for h in hits:
        print(h)
    print(f"files {len(files)} hits {len(hits)}")
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main())
