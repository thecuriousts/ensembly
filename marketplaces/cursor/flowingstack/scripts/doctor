#!/usr/bin/env python3
import argparse
import glob
import json
import os
import re
import shutil
import sys


def has(p, *parts):
    return bool(glob.glob(os.path.join(p, *parts), recursive=True))


def text(p):
    return open(p, encoding="utf-8").read() if os.path.isfile(p) else ""


def manifest_name(p):
    try:
        return json.loads(text(p)).get("name")
    except (ValueError, AttributeError):
        return None


def installed(d, name):
    return (has(d, name, "**", "SKILL.md") or has(d, name, "SKILL.md") or has(d, "**", "skills", name, "SKILL.md")
            or any(manifest_name(p) == name for p in glob.glob(os.path.join(d, "**", "plugin.json"), recursive=True, include_hidden=True)))


def checks(o, disk):
    p = o.project
    yield "model-rule", has(p, ".cursor", "rules", "pstack-models.mdc"), "run /setup-pstack"
    yield "agents-md", has(p, "AGENTS.md"), "add AGENTS.md"
    yield "ci", has(p, ".github", "workflows", "*.y*ml"), "add a CI workflow"
    yield "verify-skill", any(has(p, d, "**", g, "SKILL.md") for d in (".cursor/skills", ".agents/skills", "skills") for g in ("*verify*", "*verification*")), "add a verify skill"
    yield "hooks", has(p, ".cursor", "hooks.json"), "add .cursor/hooks.json"
    yield "aliases", bool(re.search(r"\blaptop-\d\b|\bmac-mini\b", text(os.path.join(p, "AGENTS.md")) + text(os.path.join(p, "docs", "host-aliases.md")))), "name host aliases"
    for name in ("pstack", "craft"):
        yield name, any(installed(d, name) for d in o.plugins_dir), f"/add-plugin {name}"


def main():
    a = argparse.ArgumentParser()
    a.add_argument("--project", default=".", help="product repo root, not the plugin root")
    a.add_argument("--plugins-dir", action="append", default=[])
    a.add_argument("--ci-status")
    a.add_argument("--disk-percent", type=float)
    a.add_argument("--init", action="store_true")
    o = a.parse_args()
    u = shutil.disk_usage(o.project)
    disk = o.disk_percent if o.disk_percent is not None else 100 * u.used / u.total
    bad = 0
    for name, ok, fix in checks(o, disk):
        print(f"ok {name}" if ok else f"missing {name}\t{fix}")
        bad += not ok
    if o.ci_status and re.search(r"(?i)\b(failure|failed|billing|cancelled)\b", text(o.ci_status)):
        print("fail ci-health\tread the CI status before any build step")
        bad += 1
    print(f"fail disk {disk:.0f}%" if disk >= 70 else f"ok disk {disk:.0f}%")
    bad += disk >= 70
    if o.init:
        print("next: /setup-pstack" if not has(o.project, ".cursor", "rules", "pstack-models.mdc") else "next: none, /setup-pstack already applied")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
