#!/usr/bin/env python3
import hashlib
import os
import re
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from rootpath import plugin_root

FENCE = re.compile(r"^```(mermaid|[a-zA-Z0-9-]+-beta)[^\n]*\n(.*?)^```", re.M | re.S)
MMDC = os.environ.get("MMDC", "npx -y @mermaid-js/mermaid-cli@11").split()


def pages(root):
    yield "readme", os.path.join(root, "README.md")
    d = os.path.join(root, "docs")
    for n in sorted(os.listdir(d)):
        if n.endswith(".md"):
            yield n[:-3], os.path.join(d, n)


def render(body, out):
    with tempfile.TemporaryDirectory() as t:
        src = os.path.join(t, "d.mmd")
        open(src, "w").write(body)
        r = subprocess.run(MMDC + ["-q", "-b", "white", "-i", src, "-o", out], capture_output=True, text=True)
        return r.returncode == 0, r.stderr[-400:]


def main():
    root = plugin_root()
    img = os.path.join(root, "docs", "img")
    os.makedirs(img, exist_ok=True)
    rows, bad = ["# digest\timage (known-good: Pele-only fence)"], []
    for stem, path in pages(root):
        n = {"mermaid": 0, "beta": 0}
        for kind, body in FENCE.findall(open(path).read()):
            key = "mermaid" if kind == "mermaid" else "beta"
            n[key] += 1
            name = f"{stem}-{n[key]}.svg" if key == "mermaid" else f"{stem}-beta-{n[key]}.svg"
            ok, err = render(body, os.path.join(img, name))
            if not ok and key == "mermaid":
                bad.append(f"{os.path.relpath(path, root)} block {n[key]}: {err.strip()}")
                continue
            rows.append(f"{hashlib.sha256(body.encode()).hexdigest()[:16]}\t{name if ok else 'known-good'}")
    open(os.path.join(img, "rendered.tsv"), "w").write("\n".join(rows) + "\n")
    print("\n".join(bad + [f"blocks {len(rows) - 1} failed {len(bad)}"]))
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
