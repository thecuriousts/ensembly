#!/usr/bin/env python3
import argparse
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import baseline
from rootpath import plugin_root, rel, walk

PELE = {"agentflow-beta", "architecture-beta", "swimlane-beta", "sequenceDiagram", "stateDiagram-v2", "C4Component"}
CODE = {".py": ("#", 0.10), ".mjs": ("//", 0.10), ".js": ("//", 0.10), ".ts": ("//", 0.10), ".rs": ("//", 0.10),
        ".sh": ("#", 0.15), ".yml": ("#", 0.05), ".yaml": ("#", 0.05), ".toml": ("#", 0.05)}
LINE = {".py", ".sh", ".js", ".mjs", ".ts"}
PUNCT = ".;:!"
PASSIVE = re.compile(r"\b(is|are|was|were|been) \w+ed\b")
CODEX = re.compile(r"`[^`]*`")
URL = re.compile(r"\w+://\S+")
QUOTED = re.compile(r'"[^"]*"')


def clean(s):
    return QUOTED.sub("q", URL.sub("u", CODEX.sub("c", s)))


def words(s):
    s = re.sub(r"(?i)craft gates for ub-mode", "", s).replace("AI Hero", "")
    out = [m.group(0) for m in re.finditer(r"(?i)\b(demos?|gates?)\b", s)]
    return out + re.findall(r"\b(?:AI|AGI)\b", s)


class Doc:
    def __init__(self, path, phrases):
        self.path, self.phrases, self.out, self.warn, self.allow = path, phrases, [], [], 0

    def f(self, n, rule, msg=""):
        self.out.append((self.path, n, rule, msg))

    def md(self, text):
        lines = text.split("\n")
        i = 0
        if lines and lines[0] == "---":
            i = lines.index("---", 1) + 1 if "---" in lines[1:] else 0
        kinds, fence, section, first = [], None, "", None
        for n in range(i, len(lines)):
            l = lines[n]
            if fence is not None:
                kinds.append((n, "fence", l, section))
                if fence == "mermaid" and not themed and l.strip():
                    themed = re.match(r"%%\{\s*init:.*\btheme\b", l.strip()) is not None
                if l.startswith("```"):
                    if fence == "mermaid" and not themed:
                        self.f(start + 1, "mermaid-theme", "no %%{init: {theme}} line")
                    fence = None
                continue
            if l.startswith("```"):
                fence = l[3:].split()[0] if l[3:].split() else ""
                start, themed = n, False
                if first is None:
                    first = fence in PELE
                kinds.append((n, "fence", l, section))
            elif not l.strip():
                kinds.append((n, "blank", l, section))
            elif l.startswith("#"):
                section = l.lstrip("#").strip()
                kinds.append((n, "head", l, section))
            else:
                k = "table" if l.startswith("|") else "image" if l.startswith("![") else "quote" if l.startswith(">") else "html" if l.startswith("<!--") else "prose"
                if first is None:
                    first = k == "image"
                kinds.append((n, k, l, section))
        self.quotes(kinds)
        if first is not True:
            self.f(i + 1, "order", "first block is not a Pele diagram")
        body = [k for k in kinds if k[1] not in ("blank", "head")]
        spec = sum(1 for k in body if k[1] in ("fence", "table", "image"))
        if body and spec / len(body) < 0.60:
            self.f(i + 1, "ratio", f"{spec}/{len(body)} < 0.60")
        prose = [k for k in kinds if k[1] == "prose"]
        cap = 40 if os.path.basename(self.path).lower() == "readme.md" else 25
        if len(prose) > cap:
            self.f(prose[cap][0] + 1, "prose-cap", f"{len(prose)} > {cap} per doc")
        per = {}
        for k in prose:
            per.setdefault(k[3], []).append(k)
        for sec, ks in per.items():
            if len(ks) > 8:
                self.f(ks[8][0] + 1, "prose-cap", f"{len(ks)} > 8 in section {sec}")
        for n, k, l, sec in kinds:
            self.line(n + 1, k, l, sec)

    def quotes(self, kinds):
        j = 0
        while j < len(kinds):
            if kinds[j][1] != "quote":
                j += 1
                continue
            e = j
            while e < len(kinds) and kinds[e][1] == "quote":
                e += 1
            src = re.match(r"^>\s*— \S", kinds[e - 1][2])
            for q in range(j, e):
                n, _, l, s = kinds[q]
                kinds[q] = (n, "quoted" if src else "prose", l, s)
            j = e

    def line(self, n, k, l, sec):
        if k == "html":
            if l.startswith("<!-- lint: allow"):
                self.allow += 1
            else:
                self.f(n, "html-comment")
            return
        if k == "head":
            c = clean(l)
            self.words(n, c)
            if c.rstrip() and c.rstrip()[-1] in PUNCT:
                self.f(n, "punct", "heading")
            return
        if k == "table":
            cells = l.strip().strip("|").split("|")
            if all(re.fullmatch(r"\s*:?-+:?\s*", c) for c in cells):
                return
            for c in cells:
                c = clean(c).strip()
                self.words(n, c)
                if c and c[-1] in PUNCT:
                    self.f(n, "punct", "table cell")
            return
        if k != "prose":
            return
        if l != l.rstrip():
            self.f(n, "redundant", "trailing whitespace")
        c = clean(l)
        self.words(n, c)
        low = c.lower()
        for p in self.phrases:
            if re.search(r"(?<!\w)" + re.escape(p) + r"(?!\w)", low):
                self.f(n, "filler", p)
        for pat, what in ((r"!!", "!!"), (r"\?\?", "??"), (r"\.\.\.", "..."), (r"\S {2,}\S", "double space"), (r"^\s*\*\*.*\*\*\s*$", "bold line")):
            if re.search(pat, c):
                self.f(n, "redundant", what)
        m = re.match(r"^\s*(?:[-*]|\d+\.)\s+(.*)$", c)
        if m and sec != "Notes" and len(m.group(1).split()) <= 8 and m.group(1).rstrip()[-1:] in tuple(PUNCT):
            self.f(n, "punct", "list item")
        if PASSIVE.search(c):
            self.warn.append(f"{self.path}:{n}: warn: passive")

    def words(self, n, c):
        for w in words(c):
            self.f(n, "banned-word", w)

    def code(self, text, mark, limit, ext=""):
        lines = [l for l in text.split("\n")]
        body = [(i, l.strip()) for i, l in enumerate(lines, 1) if l.strip() and not l.startswith("#!") and l.strip() != "set -euo pipefail"]
        com = [(i, l) for i, l in body if l.startswith(mark)]
        if ext in LINE:
            for i, _ in com:
                self.f(i, "comment-line")
        if body and len(com) / len(body) > limit:
            self.f(com[0][0], "comment-density", f"{len(com)}/{len(body)} > {limit}")
        nxt = dict(zip([i for i, _ in body], [l for _, l in body][1:] + [""]))
        for i, l in com:
            ct = set(re.findall(r"\w+", l.lower()))
            nt = set(re.findall(r"\w+", nxt[i].lower()))
            if ct and not nxt[i].startswith(mark) and len(ct & nt) / len(ct) >= 0.7:
                self.f(i, "comment-restate")

    def json(self, text):
        try:
            data = json.loads(text)
        except ValueError as e:
            self.f(1, "json-parse", str(e))
            return

        def visit(o):
            if isinstance(o, dict):
                for key, v in o.items():
                    if key in ("$comment", "note") and os.path.basename(self.path) != "pele-theme.json":
                        self.f(1, "json-comment", key)
                    if key == "description" and isinstance(v, str) and v.rstrip()[-1:] in tuple(PUNCT):
                        self.f(1, "punct", "description")
                    visit(v)
            elif isinstance(o, list):
                for v in o:
                    visit(v)
        visit(data)


def kind(path, text):
    ext = os.path.splitext(path)[1]
    if ext in (".md", ".mdc"):
        return "md"
    if ext == ".json":
        return "json"
    if ext in CODE:
        return ext
    head = text.split("\n", 1)[0]
    if head.startswith("#!"):
        return ".py" if "python" in head else ".sh" if re.search(r"\b(ba|z)?sh\b", head) else None
    return None


def lint(root, path, phrases, text=None):
    if text is None:
        try:
            text = open(os.path.join(root, path), encoding="utf-8").read()
        except (UnicodeDecodeError, IsADirectoryError):
            return Doc(path, phrases)
    d = Doc(path, phrases)
    k = kind(path, text)
    if k == "md":
        d.md(text)
    elif k == "json":
        d.json(text)
    elif k:
        d.code(text, *CODE[k], k)
    return d


def main():
    a = argparse.ArgumentParser()
    a.add_argument("paths", nargs="*")
    a.add_argument("--root")
    a.add_argument("--all", action="store_true")
    a.add_argument("--repo-root")
    a.add_argument("--baseline")
    a.add_argument("--write-baseline")
    a.add_argument("--stdin-md", action="store_true")
    o = a.parse_args()
    root = plugin_root(o.root)
    own = os.path.join(root, "banned-phrases.txt")
    if not os.path.exists(own):
        own = os.path.join(plugin_root(), "banned-phrases.txt")
    phrases = [p.strip().lower() for p in open(own) if p.strip()]
    for p in o.paths:
        if os.path.isabs(p) or ".." in p.split("/"):
            print(f"{p}: path must be relative to plugin root", file=sys.stderr)
            return 2
        if not os.path.exists(os.path.join(root, p)):
            print(f"{p}: not found under plugin root", file=sys.stderr)
            return 2
    if o.stdin_md:
        docs = [lint(root, "stdin.md", phrases, sys.stdin.read())]
    else:
        paths = list(walk(root, "lint-ignore")) if o.all else []
        for p in o.paths:
            full = rel(root, p)
            paths += [os.path.relpath(os.path.join(root, p, q), root) for q in walk(full, "\0")] if os.path.isdir(full) else [p]
        docs = [lint(root, p, phrases) for p in paths]
        if o.repo_root and os.path.exists(os.path.join(o.repo_root, ".cursor-plugin", "marketplace.json")):
            docs.append(lint(o.repo_root, os.path.join(".cursor-plugin", "marketplace.json"), phrases))
    base_file = o.baseline or ("lint-baseline.tsv" if o.all and os.path.exists(os.path.join(root, "lint-baseline.tsv")) else None)
    base = baseline.load(rel(root, base_file)) if base_file else {}
    found = [x for d in docs for x in d.out]
    keys = [(x[0], x[2]) for x in found]
    if o.write_baseline:
        with open(rel(root, o.write_baseline), "w") as f:
            f.writelines(baseline.rows(keys))
    live = [x for x, bad in zip(found, baseline.live(keys, base)) if bad]
    for p, n, r, m in live:
        print(f"{p}:{n}: {r}: {m}")
    for d in docs:
        for w in d.warn:
            print(w)
    counts = {}
    for x in found:
        counts[x[2]] = counts.get(x[2], 0) + 1
    print(f"files {len(docs)} findings {len(live)} baselined {len(found) - len(live)} allowed {sum(d.allow for d in docs)} by-rule {json.dumps(counts, sort_keys=True)}")
    return 1 if live else 0


if __name__ == "__main__":
    sys.exit(main())
