#!/usr/bin/env python3
import argparse
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from rootpath import plugin_root


def steps(o, root):
    repo = os.path.join(root, "..", "..", "..")
    doctor = ["--project", o.project] + [x for d in o.plugins_dir for x in ("--plugins-dir", d)]
    doctor += ["--disk-percent", o.disk_percent] if o.disk_percent else []
    yield "contract", ["contract-check", o.contract]
    yield "evals", ["eval-freeze", "verify", o.evals]
    yield "privacy", ["privacy-scan", "--all", "--repo-root", repo]
    yield "doc-lint", ["doc-lint", "--all", "--repo-root", repo]
    yield "doctor", ["doctor"] + doctor


def main():
    a = argparse.ArgumentParser(description="last check before a person lands the change; lands nothing")
    a.add_argument("--contract", required=True)
    a.add_argument("--evals", required=True)
    a.add_argument("--project", default=".")
    a.add_argument("--plugins-dir", action="append", default=[])
    a.add_argument("--disk-percent")
    o = a.parse_args()
    root = plugin_root()
    names, bad = [], []
    for name, cmd in steps(o, root):
        p = subprocess.run([sys.executable, os.path.join(root, "scripts", cmd[0])] + cmd[1:], capture_output=True, text=True, cwd=root)
        print(f"{name} exit {p.returncode}")
        if p.returncode:
            print((p.stdout + p.stderr).strip())
        names.append(name)
        bad += [name] if p.returncode else []
    print(f"ship blocked: {' '.join(bad)}" if bad else f"ship ready: {' '.join(names)}")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
