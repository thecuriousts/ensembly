#!/usr/bin/env python3
import argparse
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import baseline
from rootpath import plugin_root, rel, walk

RULES = [
    ("home-path", r"/home/[a-z_][\w.-]*|/Users/[A-Za-z][\w.-]*"),
    ("box-path", r"/(?:workspace|cursor/stores|agent-data)\b"),
    ("cgnat-ip", r"\b100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.\d{1,3}\.\d{1,3}\b"),
    ("email", r"[\w.+-]+@(?!users\.noreply\.github\.com\b|example\.(?:com|org)\b)[\w-]+(?:\.[\w-]+)+"),
    ("phone", r"\+\d{1,3}(?:[ -]?\d){7,}"),
    ("finance", r"(?i)\b(?:iba[n]|salar[y]|bank accoun[t]|loa[n]|deb[t]|invoic[e])\b"),
    ("health", r"(?i)\b(?:prescriptio[n]|therap[y]|medical recor[d])\b"),
    ("cv", r"\bCV\b|(?i:\bresum[eé]\b|\bpersonnummer\b)"),
    ("private-data", r"(?i)\bkanit[h]anj\b|\bensembl[y]\b(?!/)"),
    ("si-prof", r"(?i)\bsi[- ]profil[e]\b"),
]
MAGIC = (b"\x7fELF", b"\xfe\xed\xfa", b"\xce\xfa\xed\xfe", b"\xcf\xfa\xed\xfe", b"\xca\xfe\xba\xbe", b"MZ")


def deny_rules(path):
    if not path or not os.path.exists(path):
        return []
    return [("deny-list", r"(?i)\b" + re.escape(l.strip()) + r"\b") for l in open(path) if l.strip()]


def allow_rules(path):
    """Load rule\tliteral rows. Matching spans are removed before that rule runs."""
    if not path or not os.path.exists(path):
        return []
    out = []
    for raw in open(path):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if "\t" not in line:
            raise SystemExit(f"privacy-allow: need rule<TAB>literal, got {line!r}")
        rule, lit = line.split("\t", 1)
        lit = lit.strip()
        if not lit:
            raise SystemExit(f"privacy-allow: empty literal on rule {rule!r}")
        out.append((rule.strip(), re.compile(re.escape(lit), re.I)))
    return out


def scrub_allows(line, rule, allows):
    for a_rule, a_pat in allows:
        if a_rule in ("*", rule):
            line = a_pat.sub("", line)
    return line


def scan_text(name, text, rules, allows=None):
    allows = allows or []
    hits = []
    for n, line in enumerate(text.split("\n"), 1):
        for rule, pat in rules:
            probe = scrub_allows(line, rule, allows)
            if re.search(pat, probe):
                hits.append(f"{name}:{n}: {rule}")
    return hits


def scan_file(root, r, rules, allows=None):
    full = os.path.join(root, r)
    if os.path.islink(full):
        return [f"{r}: symlink"]
    data = open(full, "rb").read()
    if b"\0" in data or data.startswith(MAGIC):
        return [f"{r}: binary"]
    return scan_text(r, data.decode("utf-8", "replace"), rules, allows)


def own_catalog(repo, mk, root):
    text = open(mk, encoding="utf-8", errors="replace").read()
    try:
        m = json.loads(text)
        mine = os.path.realpath(root)
        m["plugins"] = [e for e in m.get("plugins", []) if os.path.realpath(os.path.join(repo, e.get("source", ""))) == mine]
    except (ValueError, AttributeError, TypeError):
        return text
    return json.dumps(m, indent=2, ensure_ascii=False)


def main():
    a = argparse.ArgumentParser()
    a.add_argument("paths", nargs="*")
    a.add_argument("--root")
    a.add_argument("--repo-root")
    a.add_argument("--all", action="store_true")
    a.add_argument("--stdin", action="store_true")
    a.add_argument("--baseline")
    a.add_argument("--deny", default=os.environ.get("PRIVACY_DENY_FILE"))
    o = a.parse_args()
    root = plugin_root(o.root)
    rules = RULES + deny_rules(o.deny)
    allow_path = os.path.join(root, "privacy-allow")
    allows = allow_rules(allow_path)
    hits, n = [], 0
    if o.stdin:
        hits += scan_text("stdin", sys.stdin.read(), rules, allows)
        n += 1
    files = list(walk(root, "privacy-ignore")) if o.all else []
    for p in o.paths:
        full = rel(root, p)
        files += [os.path.relpath(os.path.join(full, q), root) for q in walk(full, "\0")] if os.path.isdir(full) else [p]
    for r in files:
        hits += scan_file(root, r, rules, allows)
    n += len(files)
    if o.repo_root:
        mk = os.path.join(o.repo_root, ".cursor-plugin", "marketplace.json")
        if os.path.exists(mk):
            hits += scan_text(os.path.relpath(mk, o.repo_root), own_catalog(o.repo_root, mk, root), rules, allows)
            n += 1
    if o.all and not o.baseline and os.path.exists(os.path.join(root, "privacy-baseline.tsv")):
        o.baseline = "privacy-baseline.tsv"
    if o.baseline:
        base = baseline.load(rel(root, o.baseline))
        kept = [h for h, bad in zip(hits, baseline.live([(h.split(":")[0], h.rsplit(": ", 1)[-1]) for h in hits], base)) if bad]
        print(f"baselined {len(hits) - len(kept)}")
        hits = kept
    print("\n".join(hits + [f"scanned {n} hits {len(hits)}"]))
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main())
